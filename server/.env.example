# ===== LLM (对话) =====
# 兼容 OpenAI 协议的接口。本项目用 OmniRoute 的 ds 模型
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://3585616.xyz/v1
OPENAI_MODEL=ds

# ===== TTS 语音合成 (MiMo) =====
MIMO_API_KEY=sk-xxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
TTS_PROVIDER=mimo

# ===== ASR 语音转写 (MiMo) =====
MIMO_ASR_MODEL=mimo-v2.5-asr
ASR_PROVIDER=mimo

# ===== 可选：解除对话内容限制 =====
DG_UNRESTRICTED_CHAT=true

# ===== 服务监听 =====
PORT=8787
HOST=127.0.0.1

# ===== Telegram 机器人 (可选) =====
# 通过 @BotFather 申请的 Bot Token；留空则不启动 bot
TELEGRAM_BOT_TOKEN=
# 可选：填了则使用 webhook 模式，否则使用 polling（默认）
TELEGRAM_WEBHOOK=
# 访问控制：仅允许指定 TG 用户 ID 使用（逗号或空格分隔，如 123456789）。
# 留空时进入引导期——首位发送 /start 的用户自动成为主人，之后其他人被拒。
ALLOWED_TG_USER_ID=
