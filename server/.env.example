# ===== LLM (对话) =====
# 兼容 OpenAI 协议的接口。本项目用 OmniRoute 的 ds 模型
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://3585616.xyz/v1
OPENAI_MODEL=ds

# ===== TTS 语音合成 (MiMo) =====
MIMO_API_KEY=sk-xxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
TTS_PROVIDER=mimo

# ===== ASR 语音转写 (MiMo) =====
MIMO_ASR_MODEL=mimo-v2.5-asr
ASR_PROVIDER=mimo

# ===== 可选：解除对话内容限制 =====
DG_UNRESTRICTED_CHAT=true

# ===== 服务监听 =====
PORT=8787
HOST=127.0.0.1

# ===== Telegram 机器人 (可选) =====
# 通过 @BotFather 申请的 Bot Token；留空则不启动 bot
TELEGRAM_BOT_TOKEN=
# 可选：填了则使用 webhook 模式，否则使用 polling（默认）
TELEGRAM_WEBHOOK=
# 访问控制：仅允许指定 TG 用户 ID 使用（逗号或空格分隔，如 123456789）。
# 留空时进入引导期——首位发送 /start 的用户自动成为主人，之后其他人被拒。
ALLOWED_TG_USER_ID=

# ===== Matrix 渠道 (可选) =====
# Matrix 渠道的开关、homeserver、每个角色的账号与 Token 均在「设置 → 渠道」与
# 「数字人管理 → 编辑 → 渠道」里配置（存 system-config.json / human-overrides.json），
# 不需要写在本文件。这里只放「必须由环境提供」的一项：
#
# 主人账号 userId（形如 @luoyuqing:matrix.3585616.xyz）。
# ⚠️ 强烈建议显式配置：bot 首次启动时会「自己建房并邀请主人」，此时若还不知道主人是谁，
#    房间会建成只有 bot 自己的空房间，你就永远收不到邀请（静默不可用）。
#    配好本项后重启，bot 若发现你不在房间里会自动补发邀请。
#    注意：这里填的是**你自己的** Matrix 账号，不是数字人的账号。
MATRIX_OWNER_USER_ID=
