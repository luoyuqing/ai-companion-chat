OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_API_KEY=
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=tts-1-hd
AZURE_TTS_KEY=
AZURE_TTS_ENDPOINT=
DG_UNRESTRICTED_CHAT=true
PORT=8787
# --- MiMo (语音合成 TTS + 语音识别 ASR) ---
# 文档: https://mimo.mi.com/docs/zh-CN/api/audio/tts 与 .../Speech-Recognition
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
MIMO_ASR_MODEL=mimo-v2.5-asr
# 设为 mimo 启用 MiMo；设为 openai/azure 则走原有 OpenAI/Azure 通道
TTS_PROVIDER=openai
ASR_PROVIDER=openai
